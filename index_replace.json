{"oldString": "      <!-- SCAN -->\n      <div id=\"scan-section\" class=\"hidden\">", "newString": "      <!-- ALLIANCE SELECTION -->\n  <div id=\"alliance-section\" class=\"hidden\" style=\"text-align:left\">\n    <div style=\"margin-bottom:15px; border-bottom: 1px solid #333; padding-bottom: 15px; display:flex; justify-content:space-between; align-items:center;\">\n      <div>\n        <h2 style=\"margin:0; font-size:24px; color:#0a84ff\">Alliance Selection Mode</h2>\n        <p style=\"margin:5px 0 0 0;color:#aaa;font-size:13px\">Drive team strategy, pick lists, and deep-dives.</p>\n      </div>\n      <div style=\"display:flex;gap:10px;align-items:center\">\n        <label style=\"display:flex;align-items:center;gap:6px;font-size:13px;color:#ccc;cursor:pointer\">\n          <input type=\"checkbox\" id=\"alliance-datasource-statbotics\" onchange=\"loadAllianceData()\" style=\"width:auto;margin:0\"> Use Statbotics (Online)\n        </label>\n        <button onclick=\"loadAllianceData()\" style=\"width:auto;margin:0;background:#0a84ff;padding:10px 15px\">Refresh Data</button>\n        <button onclick=\"printAllianceSheet()\" style=\"width:auto;margin:0;background:#22c55e;padding:10px 15px\">Print Cheat Sheet</button>\n      </div>\n    </div>\n\n    <!-- Statbotics Prediction -->\n    <div id=\"statbotics-pred-card\" class=\"alliance-card hidden\" style=\"margin-bottom:20px; border-color:#0a84ff;\">\n      <h3 style=\"margin-top:0;color:#0a84ff;display:flex;justify-content:space-between\">\n        Statbotics Setup & Predictor\n        <span id=\"sb-pred-status\" style=\"font-size:12px;color:#888;font-weight:normal\">Waiting...</span>\n      </h3>\n      <div style=\"display:flex;gap:10px;margin-bottom:10px\">\n        <input id=\"sb-year-input\" type=\"number\" placeholder=\"Year\" value=\"2024\" style=\"width:80px;margin:0;font-family:monospace\">\n        <input id=\"sb-event-input\" type=\"text\" placeholder=\"Event (e.g. wasno)\" style=\"flex:1;margin:0;font-family:monospace\" onchange=\"if($('alliance-datasource-statbotics').checked) loadAllianceData();\">\n      </div>\n      <div style=\"display:flex;gap:10px;margin-bottom:15px\">\n        <input id=\"sb-match-input\" type=\"number\" placeholder=\"Match #\" style=\"flex:1;margin:0;font-family:monospace\">\n        <button onclick=\"fetchStatboticsPrediction()\" style=\"width:auto;margin:0;background:#0a84ff\">Get Odds</button>\n      </div>\n      <div id=\"sb-pred-result\" style=\"display:none;background:#1a1a1a;padding:15px;border-radius:6px;font-size:14px;\"></div>\n    </div>\n\n    <!-- Overview / Top Picks / DNP -->\n    <div class=\"alliance-grid\">\n      <div class=\"alliance-card\">\n        <h3 style=\"margin-top:0;color:#34d399\">Recommended Picks (Top 10)</h3>\n        <p style=\"font-size:11px;color:#888;margin-top:-5px\">Weighted by Auto, Tele, Climbs, Ferry. Penalized for downtime.</p>\n        <div id=\"alliance-recommended-list\" style=\"max-height:250px;overflow-y:auto;font-size:13px;\"></div>\n      </div>\n      <div class=\"alliance-card\">\n        <h3 style=\"margin-top:0;color:#ff453a\">Do Not Pick / High Risk</h3>\n        <p style=\"font-size:11px;color:#888;margin-top:-5px\">Teams with significant incapacitation or high failure rates.</p>\n        <div id=\"alliance-dnp-list\" style=\"max-height:250px;overflow-y:auto;font-size:13px;\"></div>\n      </div>\n    </div>\n\n    <!-- Predicted Pick List -->\n    <div class=\"alliance-card\" style=\"margin-bottom:20px\">\n      <h3 style=\"margin-top:0;color:#a855f7\">Predicted Pick List (Snake Draft)</h3>\n      <p style=\"font-size:11px;color:#888;margin-top:-5px\" id=\"predicted-list-subtitle\">Based on calculated Power Rank (Local or Statbotics)</p>\n      <div id=\"predicted-alliances-grid\" style=\"display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; font-size:13px; margin-top:10px;\">\n        <!-- Filled by JS -->\n      </div>\n    </div>\n\n    <!-- Deep Dive -->\n    <div class=\"alliance-card\" style=\"margin-bottom:20px\">\n      <h3 style=\"margin-top:0\">Team Deep-Dive & Match Timeline</h3>\n      <div style=\"display:flex;gap:10px;margin-bottom:15px\">\n        <input id=\"alliance-search-input\" type=\"number\" placeholder=\"Enter Team # (e.g. 254)\" style=\"width:200px;margin:0\">\n        <button onclick=\"renderTeamDeepDive()\" style=\"width:auto;margin:0\">Analyze Team</button>\n      </div>\n      <div id=\"alliance-deep-dive-content\" style=\"display:none;background:#1a1a1a;padding:15px;border-radius:6px\">\n      </div>\n    </div>\n\n    <!-- Full Roster -->\n    <div class=\"alliance-card\">\n      <h3 style=\"margin-top:0\">Full Roster Matrix</h3>\n      <table class=\"sortable\">\n        <thead>\n          <tr>\n            <th onclick=\"sortAllianceTable('teamNumber')\">Team &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('opr')\">Pwr Rank &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('avgScore')\">Avg Pts &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('avgAuto')\">Auto Pts &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('avgTele')\">Tele Hubs &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('avgFerry')\">Ferry Vol &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('climbRate')\">Climb% &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('avgIncap')\">Incap (s) &#x21D5;</th>\n            <th onclick=\"sortAllianceTable('matches')\">Matches &#x21D5;</th>\n          </tr>\n        </thead>\n        <tbody id=\"alliance-roster-body\">\n          <tr><td colspan=\"9\" style=\"text-align:center\">Click 'Refresh Data' to load</td></tr>\n        </tbody>\n      </table>\n    </div>\n  </div>\n\n      <!-- SCAN -->\n      <div id=\"scan-section\" class=\"hidden\">"}